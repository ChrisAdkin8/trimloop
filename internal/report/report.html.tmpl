<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'">
<meta name="referrer" content="no-referrer">
<title>Trimloop report</title>
<style>
:root {
  --bg: #f7f7f5; --panel: #ffffff; --text: #1d1d1b; --muted: #66665f; --line: #e4e3de;
  --accent: #2f6f5e; --accent-soft: #d9ebe4; --warn: #9c4a22; --warn-soft: #f6e3d8;
  --bar: #2f6f5e; --bar2: #9cc8b8; --bar3: #c98a5e; --bar4: #8d8c86; --bar5: #d6c27a; --code: #f1f0ec;
  --size1: #0ca30c; --size2: #1baf7a; --size3: #eda100; --size4: #d03b3b;
  --kind1: #2a78d6; --kind2: #eb6834; --kind3: #1baf7a; --kind4: #eda100;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #161715; --panel: #1f201e; --text: #ecebe6; --muted: #a9a8a1; --line: #34352f;
    --accent: #7cc4a9; --accent-soft: #24392f; --warn: #f0a07a; --warn-soft: #3d2a20;
    --bar: #7cc4a9; --bar2: #3f6b5b; --bar3: #c98a5e; --bar4: #77766f; --bar5: #8a7a3a; --code: #2a2b27;
    --size1: #0ca30c; --size2: #199e70; --size3: #c98500; --size4: #e66767;
    --kind1: #3987e5; --kind2: #d95926; --kind3: #199e70; --kind4: #c98500;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
main { max-width: 1000px; margin: 0 auto; padding: 32px 16px 64px; }
h1 { font-size: 26px; margin: 0 0 2px; }
h2 { font-size: 20px; margin: 44px 0 6px; }
h3 { font-size: 15px; margin: 22px 0 8px; }
p { margin: 6px 0; max-width: 75ch; }
.lead { color: var(--muted); margin-bottom: 14px; }
.muted { color: var(--muted); }
.small { font-size: 14px; }
.panel { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px; }
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin: 14px 0; }
.tile .num { font-size: 24px; font-weight: 650; line-height: 1.2; }
.tile .lbl { color: var(--muted); font-size: 13px; }
.panel .tiles .tile { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; }
.cards { display: grid; gap: 14px; }
.card { border-left: 4px solid var(--accent); }
.card h3 { margin: 0 0 6px; font-size: 18px; }
.code { font-size: 11px; color: var(--muted); border: 1px solid var(--line); border-radius: 4px; padding: 0 5px; margin-left: 6px; vertical-align: 2px; font-weight: 500; }
.money { margin: 8px 0; }
.money .likely { font-size: 20px; font-weight: 650; color: var(--accent); }
.note { background: var(--warn-soft); color: var(--warn); border-radius: 6px; padding: 3px 8px; font-size: 13px; display: inline-block; margin: 4px 0; }
.fix { margin-top: 12px; }
.how { position: relative; background: var(--code); border-radius: 6px; padding: 10px 76px 10px 12px;
  font: 13px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; white-space: pre-wrap; word-break: break-word; }
.copy { position: absolute; top: 6px; right: 6px; font-size: 12px; padding: 3px 9px; border-radius: 5px;
  border: 1px solid var(--line); background: var(--panel); color: var(--text); cursor: pointer; }
details { margin-top: 10px; }
summary { cursor: pointer; color: var(--accent); font-size: 15px; }
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--line); vertical-align: middle; }
th { font-size: 13px; color: var(--muted); font-weight: 600; }
th[data-sort] { cursor: pointer; user-select: none; }
th[data-sort]::after { content: " ↕"; opacity: .4; }
td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
td.name { word-break: break-word; }
.id { display: block; font-size: 13px; color: var(--muted); }
td.session { min-width: 16em; }
.mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }
.scroll { overflow-x: auto; }
.barcell { width: 34%; min-width: 110px; }
.bar { height: 12px; border-radius: 3px; background: var(--bar); position: relative; overflow: hidden; }
.bar .part { position: absolute; right: 0; top: 0; bottom: 0; background: var(--bar2); }
.legend { font-size: 14px; color: var(--muted); max-width: none; }
.legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin: 0 4px 0 10px; vertical-align: -1px; }
.legend i:first-child { margin-left: 0; }
.stack { display: flex; height: 18px; border-radius: 4px; overflow: hidden; margin: 8px 0; }
.stack span { display: block; height: 100%; }
dl.glossary { display: grid; grid-template-columns: 11em 1fr; gap: 6px 16px; margin: 0; }
dl.glossary dt { font-weight: 600; }
dl.glossary dd { margin: 0; color: var(--muted); }
a { color: var(--accent); }
.summary h2 { margin: 0 0 2px; font-size: 20px; }
.summary .row { display: flex; align-items: center; gap: 12px; margin: 8px 0; }
.summary .row b { width: 4.5em; font-size: 13px; font-weight: 600; color: var(--muted); }
.strip { flex: 1; display: flex; gap: 2px; height: 22px; border-radius: 5px; overflow: hidden; }
.strip span { display: block; height: 100%; min-width: 2px; }
.summary .legend { margin: 8px 0 0; line-height: 1.9; }
.summary .legend span { white-space: nowrap; margin-right: 14px; }
.summary .legend i { margin-left: 0; }
.summary + .summary { margin-top: 12px; }
.size1 { background: var(--size1); } .size2 { background: var(--size2); }
.size3 { background: var(--size3); } .size4 { background: var(--size4); }
.kind1 { background: var(--kind1); } .kind2 { background: var(--kind2); }
.kind3 { background: var(--kind3); } .kind4 { background: var(--kind4); }
nav.toc { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 18px 0 0; font-size: 15px; }
section.area h2 { margin-bottom: 4px; }
section.area details > .panel { margin-top: 10px; }
.card details { margin-top: 8px; }
footer { margin-top: 40px; color: var(--muted); font-size: 14px; }
@media (max-width: 640px) { .barcell { display: none; } dl.glossary { grid-template-columns: 1fr; } }
</style>
</head>
<body>
<main>

<h1>Where your Claude Code tokens went</h1>
<p class="lead">
{{with .Period}}{{if .Days}}{{day .From}} to {{day .To}} ({{.Days}} days) · {{end}}{{end}}{{dollars .Total}} spent{{if .Period.PerWeek}}, about {{dollars .Period.PerWeek}} a week{{end}} · {{thousands .Read.Sessions}} sessions · list prices as of {{.Prices}}
{{if .Read.Failed}}<br><span class="note">{{.Read.Failed}} log files could not be read to the end.</span>{{end}}
{{if .Read.BadLines}}<br><span class="note">{{.Read.BadLines}} lines could not be read; Claude Code's log format may have changed.</span>{{end}}
{{if .Read.Unpriced}}<br><span class="muted small">{{.Read.Unpriced}} turns used a model with no known price and are left out.</span>{{end}}
</p>

{{with .Summary}}{{if .Bands}}
<section class="panel summary" aria-label="Spend by session size">
  <h2>{{p0 .LargeSpendShare}} of your spend came from turns over {{short .Threshold}} tokens</h2>
  <p class="muted">A token is a word-piece of about four characters. Every turn sends the whole session so far, so turns get dearer as a session grows: only {{p0 .LargeTurnShare}} of turns were this large{{if and .LargeCost .SmallCost}}, but each cost {{.LargeCost}}, against {{.SmallCost}} for smaller ones{{end}}.</p>
  <div class="row"><b>Spend</b><div class="strip" role="img" aria-label="Share of spend by session size">{{range .Bands}}<span class="{{.Class}}" style="width: {{w .SpendShare}}%" title="{{.Label}} tokens: {{dollars .Cost}} ({{p0 .SpendShare}} of spend)"></span>{{end}}</div></div>
  <div class="row"><b>Turns</b><div class="strip" role="img" aria-label="Share of turns by session size">{{range .Bands}}<span class="{{.Class}}" style="width: {{w .TurnShare}}%" title="{{.Label}} tokens: {{p0 .TurnShare}} of turns"></span>{{end}}</div></div>
  <p class="legend">{{range .Bands}}<span><i class="{{.Class}}"></i>{{.Label}} tokens: {{dollars .Cost}}, {{p0 .SpendShare}} of spend, {{p0 .TurnShare}} of turns</span>{{end}}</p>
</section>
<section class="panel summary" aria-label="What filled the session">
  <h2>{{dollars .Input}} paid to send the session to Claude</h2>
  <p class="muted">Claude's replies cost another {{dollars .Output}}. This is what was being sent.</p>
  <div class="row"><div class="strip" role="img" aria-label="What filled the session, by cost">{{range .Fill}}<span class="{{.Class}}" style="width: {{w .Share}}%" title="{{.Label}}: {{dollars .Cost}}"></span>{{end}}</div></div>
  <p class="legend">{{range .Fill}}<span><i class="{{.Class}}"></i>{{.Label}}: {{dollars .Cost}} ({{p0 .Share}})</span>{{end}}</p>
</section>
{{end}}{{end}}

<nav class="toc" aria-label="Sections">
  <a href="#actions">What to do</a><a href="#money">Where the money went</a>{{if .Weeks}}<a href="#weeks">Week by week</a>{{end}}<a href="#long">Long sessions</a><a href="#tools">Tool output</a><a href="#carried">What every request carries</a><a href="#subagents">Sub-agents</a>{{if .Reconciliation.Sessions}}<a href="#checks">Checking the totals</a>{{end}}<a href="#words">Words used</a>
</nav>

<h2 id="actions">What to do first</h2>
<p class="lead">Largest possible saving first. Several of these target the same money, so their savings can't be added up.</p>
{{if not .First}}<p>Nothing found was worth changing.</p>{{end}}
<div class="cards">
{{range .First}}{{template "action" (args . $.Total)}}{{end}}
</div>
{{if .More}}
<details><summary>{{len .More}} smaller changes</summary>
<div class="cards" style="margin-top:12px">
{{range .More}}{{template "action" (args . $.Total)}}{{end}}
</div>
</details>
{{end}}

<section class="area">
<h2 id="money">Where the money went</h2>
<p class="lead">{{with .TopProject}}{{.Name}} was the costliest project, at {{dollars .Cost}} ({{pct .Cost $.Total}}).{{end}}{{with .Largest}} {{if ge .Share 0.5}}Most{{else}}The largest part{{end}} of the spend ({{share .Share}}) paid for {{.What}}.{{end}}</p>
<details><summary>Show details</summary>
<div class="panel">
  <h3 style="margin-top:0">What the money paid for</h3>
  {{with .Cost}}
  <div class="stack" role="img" aria-label="Spend by kind of token">
    <span style="width: {{width .CacheRead $.Total}}%; background: var(--bar)" title="Re-reading the session from the cache"></span>
    <span style="width: {{width .CacheWrite1h $.Total}}%; background: var(--bar2)" title="Saving the session to the cache, kept 1 hour"></span>
    <span style="width: {{width .CacheWrite5m $.Total}}%; background: var(--bar3)" title="Saving the session to the cache, kept 5 minutes"></span>
    <span style="width: {{width .Output $.Total}}%; background: var(--bar4)" title="Claude's replies"></span>
    <span style="width: {{width .InputUncached $.Total}}%; background: var(--bar5)" title="New input sent without the cache"></span>
  </div>
  <p class="legend"><i style="background:var(--bar)"></i>Re-reading from the cache {{dollars .CacheRead}} ({{pct .CacheRead $.Total}})
    <i style="background:var(--bar2)"></i>Saving to the cache, kept 1 hour {{dollars .CacheWrite1h}} ({{pct .CacheWrite1h $.Total}})
    <i style="background:var(--bar3)"></i>Saving to the cache, kept 5 minutes {{dollars .CacheWrite5m}} ({{pct .CacheWrite5m $.Total}})
    <i style="background:var(--bar4)"></i>Claude's replies {{dollars .Output}} ({{pct .Output $.Total}})
    <i style="background:var(--bar5)"></i>New input sent without the cache {{dollars .InputUncached}} ({{pct .InputUncached $.Total}})</p>
  {{end}}

  <h3>By project</h3>
  <p class="legend">Bar length is spend; <i style="background:var(--bar2)"></i>the light part was spent by sub-agents.</p>
  <div class="scroll"><table class="sortable">
    <thead><tr><th data-sort>Project</th><th class="n" data-sort>Spent</th><th class="n" data-sort>Share</th><th class="n" data-sort>Sessions</th><th class="n" data-sort>By sub-agents</th><th class="barcell"></th></tr></thead>
    <tbody>
    {{range .Attribution.ByProject}}<tr>
      <td class="name">{{.Name}}</td><td class="n" data-v="{{.Cost}}">{{dollars .Cost}}</td><td class="n" data-v="{{.Cost}}">{{pct1 .Cost $.Total}}</td>
      <td class="n" data-v="{{.Conversations}}">{{.Conversations}}</td>
      <td class="n" data-v="{{.SubAgentCost}}">{{pct .SubAgentCost .Cost}}</td>
      <td class="barcell"><div class="bar" style="width: {{width .Cost $.MaxProject}}%"><div class="part" style="width: {{width .SubAgentCost .Cost}}%"></div></div></td>
    </tr>{{end}}
    </tbody>
  </table></div>

  {{if or .Attribution.BySkill .Attribution.ByPlugin .Attribution.ByMCPServer}}
  <h3>By skill, plugin and MCP server</h3>
  <p class="muted small">Claude Code names a skill, plugin or MCP server (a connected tool provider) on some turns. The cost is those turns' cost, which can include work that followed the tool.</p>
  {{template "spend" (args "Skill" .Attribution.BySkill $.Total false)}}
  {{template "spend" (args "Plugin" .Attribution.ByPlugin $.Total false)}}
  {{template "spend" (args "MCP server" .Attribution.ByMCPServer $.Total true)}}
  {{end}}
</div>
</details>
</section>

{{if .Weeks}}
<section class="area">
<h2 id="weeks">Week by week</h2>
<p class="lead">{{with .Busiest}}{{if .Spend}}The busiest week began {{weekStart .Week}}, at {{dollars .Spend}}.{{end}}{{end}} Compare the weeks before and after a change to see whether it worked.</p>
<details><summary>Show details</summary>
<div class="panel">
  <div class="scroll"><table>
    <thead><tr><th>Week of</th><th class="n">Spent</th><th class="n">Turns</th><th class="n">In large turns</th><th class="n">By sub-agents</th><th class="n">Tool output</th><th class="n">Re-reads</th><th class="n">Compactions</th><th class="barcell"></th></tr></thead>
    <tbody>
    {{range .Weeks}}<tr>
      <td style="white-space:nowrap">{{weekStart .Week}}{{if .Kept}} <span class="muted small">(kept)</span>{{end}}{{if $.Older .}} <span class="muted small">(older prices or method)</span>{{end}}{{if eq .Week $.ThisWeek}} <span class="muted small">(so far)</span>{{end}}</td>
      <td class="n">{{dollars .Spend}}</td><td class="n">{{thousands .Turns}}</td>
      <td class="n">{{pct .LargeContext .Spend}}</td><td class="n">{{pct .SubAgents .Spend}}</td>
      <td class="n">{{dollars .ToolOutput}}</td><td class="n">{{pct (float .Rereads) (float .FileViews)}}</td><td class="n">{{.Compactions}}</td>
      <td class="barcell"><div class="bar" style="width: {{width .Spend $.MaxWeek}}%"></div></td>
    </tr>{{end}}
    </tbody>
  </table></div>
  <p class="muted small">"In large turns": the week's spend sent in turns over {{short .Context.Threshold}} tokens. "Tool output": the cost of keeping that week's tool output in the session. "Re-reads": file views that re-read a file already seen, unchanged. "Kept": figures from earlier runs, after Claude Code deleted some or all of the week's logs. "Older prices or method": worked out with an earlier price list or analysis, so they may not compare exactly.</p>
</div>
</details>
</section>
{{end}}

<section class="area">
<h2 id="long">Long sessions and breaks</h2>
<p class="lead">{{if .TopFive}}The 5 costliest sessions made {{share .TopFive}} of spend.{{end}}{{with .Growth}}{{if .Uncompacted}} {{.Uncompacted}} grew past {{short .Limit}} tokens without ever compacting ({{dollars .UncompactedCost}}).{{end}}{{end}}{{with .Pause}}{{if .Pauses}} Coming back after more than {{duration .MinGap}} cost {{dollars .Cost}} in re-saving the cache.{{end}}{{end}}</p>
<details><summary>Show details</summary>
<div class="panel">
  {{with .Growth}}
  <h3 style="margin-top:0">Costliest sessions</h3>
  <div class="scroll"><table class="sortable">
    <thead><tr><th data-sort>Session</th><th data-sort>Project</th><th class="n" data-sort>Spent</th><th class="n" data-sort>Share</th><th class="n" data-sort>Turns</th><th class="n" data-sort>Largest size (tokens)</th></tr></thead>
    <tbody>
    {{range .Top}}{{$l := $.Name .ID}}<tr>
      <td class="name session">{{template "session" (args $l .ID)}}</td><td class="name">{{.Project}}</td>
      <td class="n" data-v="{{.Cost}}">{{dollars .Cost}}</td><td class="n" data-v="{{.Cost}}">{{pct1 .Cost $.Total}}</td>
      <td class="n" data-v="{{.Turns}}">{{thousands .Turns}}</td><td class="n" data-v="{{.Peak}}">{{short .Peak}}</td></tr>{{end}}
    </tbody>
  </table></div>
  <p class="muted small">A typical session cost {{dollars .MedianCost}}.</p>

  <h3>Compaction</h3>
  <p>Compacting replaces the session with a short summary. Claude Code did it {{.Compactions}} times ({{.Manual}} when asked){{if .MedianBefore}}, typically shrinking {{short .MedianBefore}} tokens to a {{short .MedianAfter}} summary{{if .MedianResume}}; with the system prompt and re-attached files, the next request sent about {{short .MedianResume}}{{end}}{{end}}{{if .Longest}}; the longest wait was {{duration .Longest}}{{end}}.</p>
  {{end}}

  {{with .Pause}}
  <h3>Long breaks</h3>
  <p>{{.Pauses}} times in {{.Sessions}} sessions, work carried on after more than {{duration .MinGap}} away. The cache had expired, so the next turn paid to save the whole session again: {{dollars .Cost}} ({{pct .Cost $.Total}} of spend).{{if .Unprompted}} {{.Unprompted}} of these waits ({{dollars .UnpromptedCost}}) followed no message from you: Claude was waiting on a tool, a sub-agent or a timer. The other {{dollars .Saving}} followed breaks you took.{{end}}</p>
  {{end}}
</div>
</details>
</section>

<section class="area">
<h2 id="tools">Tool output</h2>
{{with .Tools}}
<p class="lead">When Claude runs a command or reads a file, the output stays in the session and is sent again on every later turn. Keeping it there cost {{dollars .Carried}} ({{pct .Carried $.Total}} of spend){{if .FileViews}}, and {{pct (float .Rereads) (float .FileViews)}} of file views re-read a file already seen{{end}}.</p>
<details><summary>Show details</summary>
<div class="panel">
  <h3 style="margin-top:0">By tool</h3>
  <table>
    <tbody>
    {{range .ByTool}}<tr><td class="name" style="width:14em">{{.Name}}</td><td class="n" style="width:6em">{{dollars .Carried}}</td>
      <td class="n muted" style="width:8em">{{thousands .Calls}} uses</td>
      <td><div class="bar" style="width: {{width .Carried $.MaxTool}}%"></div></td></tr>{{end}}
    </tbody>
  </table>

  {{if .ByShape}}
  <h3>Shell commands by type</h3>
  <p class="muted small">Commands are grouped with file names and values removed, so <span class="mono">sed -n '1,50p' a.go</span> and <span class="mono">sed -n '9,20p' b.go</span> are one type. "Already filtered" is the share whose output was cut down, for example with head or grep.</p>
  <div class="scroll"><table class="sortable">
    <thead><tr><th data-sort>Command type</th><th class="n" data-sort>Cost to keep</th><th class="n" data-sort>Uses</th><th class="n" data-sort>Tokens</th><th class="n" data-sort>Already filtered</th></tr></thead>
    <tbody>
    {{range .ByShape}}<tr><td class="mono name">{{.Name}}</td><td class="n" data-v="{{.Carried}}">{{dollars .Carried}}</td>
      <td class="n" data-v="{{.Calls}}">{{thousands .Calls}}</td><td class="n" data-v="{{.Tokens}}">{{thousands .Tokens}}</td>
      <td class="n" data-v="{{.Filtered}}">{{pct (float .Filtered) (float .Calls)}}</td></tr>{{end}}
    </tbody>
  </table></div>
  {{end}}
</div>
</details>
{{end}}
</section>

<section class="area">
<h2 id="carried">What every request carries</h2>
{{with .Standing}}
<p class="lead">Each request also sends Claude Code's own instructions (the system prompt), the definitions of every tool, and text Claude Code adds such as the skill list and CLAUDE.md. That cost {{dollars .Total}} ({{pct .Total $.Total}} of spend).</p>
<details><summary>Show details</summary>
<div class="panel">
  {{if $.StandingGap}}<p class="muted small">Claude Code recorded the system prompt and tools for {{pct (float .Covered) (float .Turns)}} of turns; the rest are not counted.</p>{{end}}
  <div class="scroll"><table>
    <thead><tr><th>Source</th><th class="n">Cost</th><th class="n">Size</th><th>Who can change it</th><th class="barcell"></th></tr></thead>
    <tbody>
    {{range $i, $p := .Parts}}{{if lt $i 12}}<tr>
      <td class="name">{{ctxname .Name}}</td><td class="n">{{dollars .Cost}}</td><td class="n">{{short .Tokens}} tokens</td>
      <td class="muted small">{{if eq .Source "harness"}}Claude Code (no setting){{else if eq .Source "skills"}}you: skills and plugins{{else if eq .Source "mcp"}}you: MCP servers{{else}}you: memory files{{end}}</td>
      <td class="barcell"><div class="bar" style="width: {{width .Cost $.MaxPart}}%"></div></td>
    </tr>{{end}}{{end}}
    </tbody>
  </table></div>
</div>
</details>
{{end}}
</section>

<section class="area">
<h2 id="subagents">Sub-agents</h2>
{{with .SubAgents}}
{{if .Runs}}
<p class="lead">Sub-agents are helpers Claude starts for side tasks. {{thousands .Runs}} runs cost {{dollars .Cost}} ({{pct .Cost $.Total}} of spend){{if $.SubCostly}}; {{share $.SubCostly}} of that was on a model with a cheaper choice{{end}}.</p>
<details><summary>Show details</summary>
<div class="panel">
  <div class="scroll"><table class="sortable">
    <thead><tr><th data-sort>Agent type</th><th class="n" data-sort>Spent</th><th class="n" data-sort>Runs</th><th class="n" data-sort>On a cheaper model, less by</th><th data-sort>Model</th><th data-sort>Suggested</th></tr></thead>
    <tbody>
    {{range .ByType}}<tr><td class="name">{{agent .Type}}</td><td class="n" data-v="{{.Cost}}">{{dollars .Cost}}</td><td class="n" data-v="{{.Runs}}">{{.Runs}}</td>
      <td class="n" data-v="{{.Saving}}">{{dollars .Saving}}</td>
      <td>{{model .Model}}</td><td>{{if .Alternative}}{{model .Alternative}}{{else}}<span class="muted">—</span>{{end}}</td></tr>{{end}}
    </tbody>
  </table></div>
  <p class="muted small">Each run starts with an empty session, so {{share .WriteShare}} of sub-agent spend goes on saving to the cache ({{share .MainWriteShare}} in main sessions). No cheaper model is suggested for "fork" agents: they continue the main session and reuse its cache.</p>
</div>
</details>
{{else}}<p class="lead">No sub-agent runs.</p>{{end}}
{{end}}
</section>

{{with .Reconciliation}}{{if .Sessions}}
<section class="area">
<h2 id="checks">Checking the totals</h2>
<p class="lead">{{if ge .Gap 0.0}}Claude Code's own records show {{dollars .Gap}} ({{pct .Gap .Ours}}) more than its logs: requests the logs don't record, such as session titles, summaries after a break, compactions and web searches.{{else}}The logs show {{dollars (neg .Gap)}} more than Claude Code's own records; its records may have been written before some sessions ended.{{end}}{{if .Unrecorded}} {{.Unrecorded}} sessions ({{pct .UnrecordedCost $.Total}} of spend) have no record to check against.{{end}}</p>
<details><summary>Show details</summary>
<div class="panel">
  <p>For {{.Sessions}} sessions with a record, Claude Code recorded {{dollars .Harness}} and the logs show {{dollars .Ours}}.{{if .WebSearches}} {{.WebSearches}} web searches cost about {{dollars .WebSearchCost}} in search fees.{{end}}{{if .Behind}} {{.Behind}} sessions went on after their record was last written and are left out.{{end}}{{if .Unpriced}} {{.Unpriced}} sessions used a model with no known price and are left out.{{end}}</p>
  <div class="scroll"><table>
    <thead><tr><th>Model</th><th class="n">Claude Code's record</th><th class="n">In the logs</th><th class="n">Difference</th></tr></thead>
    <tbody>
    {{range .ByModel}}<tr><td>{{model .Model}}</td><td class="n">{{dollars .Harness}}</td><td class="n">{{dollars .Ours}}</td><td class="n">{{dollars .Gap}}</td></tr>{{end}}
    </tbody>
  </table></div>
</div>
</details>
</section>
{{end}}{{end}}

<section class="area">
<h2 id="words">Words used in this report</h2>
<details><summary>Show the words</summary>
<div class="panel">
<dl class="glossary">
  <dt>Token</dt><dd>The unit Claude is paid by: a word-piece of about four characters.</dd>
  <dt>Turn</dt><dd>One request to Claude and its reply. One prompt from you can take many turns while Claude works.</dd>
  <dt>Session</dt><dd>One Claude Code conversation, with any sub-agents it started. Every turn sends the whole session so far.</dd>
  <dt>Session size</dt><dd>How many tokens a turn sends: everything said so far, including tool output.</dd>
  <dt>Cache</dt><dd>A saved copy of the session that Claude can re-read cheaply. It expires after 5 minutes or 1 hour without use.</dd>
  <dt>Compact</dt><dd>Replace the session with a short summary (/compact in Claude Code).</dd>
  <dt>Sub-agent</dt><dd>A helper Claude starts for a side task; only its final report returns to the main session.</dd>
  <dt>MCP server</dt><dd>A connected tool provider, such as a browser or an issue tracker.</dd>
  <dt>System prompt</dt><dd>Claude Code's own instructions to Claude, sent at the start of every request.</dd>
  <dt>Memory file</dt><dd>A file such as CLAUDE.md whose instructions are added to every session.</dd>
  <dt>Likely, up to</dt><dd>"Likely" is an estimate for one change; "up to" is the most it could save.</dd>
</dl>
</div>
</details>
</section>

<footer>
  <p>Costs are estimates at list prices ({{.Prices}}); tool output and added text are sized at about 4 characters per token. Savings are estimates and overlap.</p>
  <p>Written by trimloop on {{date .Generated}}, on this machine. The page loads nothing from the network. It shows project names and session titles, which summarise what you asked: check before sharing it.</p>
</footer>

</main>

{{define "session"}}{{$l := index . 0}}{{$id := index . 1}}{{if $l.Title}}{{$l.Title}}{{else}}<span class="muted">Untitled session</span>{{end}}{{if $l.SubAgent}} <span class="muted small">(a sub-agent)</span>{{end}}{{if not $l.Start.IsZero}}<span class="id" title="Session {{$id}}">{{day $l.Start}}</span>{{end}}{{end}}

{{define "action"}}{{$a := index . 0}}{{$total := index . 1}}
<div class="panel card">
  <h3>{{$a.Title}}</h3>
  {{if $a.Finding}}<p>{{$a.Finding}}</p>{{end}}
  <p class="money">{{if $a.Likely}}<span class="likely">likely about {{dollars $a.Likely}}</span> <span class="muted">· up to {{dollars $a.Saving}}</span>{{else}}<span class="likely">up to {{dollars $a.Saving}}</span>{{if $a.Examples}} <span class="muted">· mostly {{join $a.Examples ", "}}</span>{{end}}{{end}}</p>
  <div class="fix">
    <p><b>{{$a.Primary.What}}</b></p>
    <div class="how">{{$a.Primary.How}}<button class="copy" type="button">Copy</button></div>
  </div>
  {{if $a.Check}}<p class="small"><b>Then check:</b> {{$a.Check}}</p>{{end}}
  <details><summary>More</summary>
    {{if $a.LikelyNote}}<p class="small">How "likely" was worked out: {{$a.LikelyNote}}</p>{{end}}
    {{if $a.Overlap}}<p class="small">{{$a.Overlap}}.</p>{{end}}
    <p class="small muted">{{pct $a.Saving $total}} of spend at most · Trimloop pattern {{$a.Pattern}}</p>
    {{range $a.Alternatives}}
    <div class="fix">
      <p><b>Or: {{.What}}</b></p>
      <div class="how">{{.How}}<button class="copy" type="button">Copy</button></div>
    </div>
    {{end}}
  </details>
</div>
{{end}}

{{define "spend"}}{{$rows := index . 1}}{{$total := index . 2}}{{$servers := index . 3}}{{if $rows}}
<h3>{{index . 0}}</h3>
<div class="scroll"><table class="sortable">
  <thead><tr><th data-sort>Name</th><th class="n" data-sort>Spent</th><th class="n" data-sort>Share</th><th class="n" data-sort>Turns</th><th class="n" data-sort>Sessions</th></tr></thead>
  <tbody>
  {{range $rows}}<tr><td class="name">{{if $servers}}{{server .Name}}{{else}}{{.Name}}{{end}}</td><td class="n" data-v="{{.Cost}}">{{dollars .Cost}}</td><td class="n" data-v="{{.Cost}}">{{pct1 .Cost $total}}</td>
    <td class="n" data-v="{{.Turns}}">{{thousands .Turns}}</td><td class="n" data-v="{{.Conversations}}">{{.Conversations}}</td></tr>{{end}}
  </tbody>
</table></div>
{{end}}{{end}}

<script>
// Copy buttons: copy the fix text, without the button's own label.
document.querySelectorAll('.copy').forEach(function (b) {
  b.addEventListener('click', function () {
    var text = b.parentNode.firstChild.textContent.trim();
    var done = function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy'; }, 1500); };
    if (navigator.clipboard) { navigator.clipboard.writeText(text).then(done, function () {}); }
  });
});
// Sortable tables: click a heading to sort; click again to reverse.
document.querySelectorAll('table.sortable').forEach(function (table) {
  table.querySelectorAll('th[data-sort]').forEach(function (th, col) {
    th.addEventListener('click', function () {
      var body = table.tBodies[0];
      var rows = Array.prototype.slice.call(body.rows);
      var desc = th.dataset.dir !== 'desc';
      th.dataset.dir = desc ? 'desc' : 'asc';
      rows.sort(function (a, b) {
        var x = a.cells[col], y = b.cells[col];
        var xv = x.dataset.v !== undefined ? parseFloat(x.dataset.v) : x.textContent.trim().toLowerCase();
        var yv = y.dataset.v !== undefined ? parseFloat(y.dataset.v) : y.textContent.trim().toLowerCase();
        var c = xv < yv ? -1 : xv > yv ? 1 : 0;
        return desc ? -c : c;
      });
      rows.forEach(function (r) { body.appendChild(r); });
    });
  });
});
</script>
</body>
</html>
